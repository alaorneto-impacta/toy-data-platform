# Cube Core — camada semântica self-hosted, lendo o Trino.

# --- modo de execução ---
# Dev mode liga o Playground para a aula. É um bypass de autenticação das APIs
# REST/GraphQL: aceitável só porque é um ambiente didático local. Ainda assim,
# a SQL API tem credenciais explícitas (abaixo) — sem elas, o Cube aceitaria
# qualquer credencial e liberaria SQL arbitrário.
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=didactic-secret

# --- fonte de dados: Trino ---
CUBEJS_DB_TYPE=trino
CUBEJS_DB_HOST=trino
CUBEJS_DB_PORT=8080
CUBEJS_DB_USER=cube
# Trino local não usa TLS; mandar senha em HTTP é recusado
# ("Password not allowed for insecure authentication"). Por isso a senha vazia.
CUBEJS_DB_PASS=
CUBEJS_DB_PRESTO_CATALOG=refined
CUBEJS_DB_NAME=ml

# --- SQL API (protocolo Postgres) ---
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_USER=cube
CUBEJS_SQL_PASSWORD=cubecubecube
