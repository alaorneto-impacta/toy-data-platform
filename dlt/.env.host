# dlt environment for running on the HOST (optional path: venv, no container).
#
# Prerequisite: the internal MinIO name `minio` MUST resolve to the host
# (e.g. an /etc/hosts entry `127.0.0.1 minio`). The Iceberg REST catalog
# returns the storage endpoint to the client and that endpoint cannot be
# overridden by dlt, so writes always go to `http://minio:9000`.
# See dlt/README.md for the full explanation.
DESTINATION__FILESYSTEM__BUCKET_URL=s3://raw
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=root
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=rootrootroot
DESTINATION__FILESYSTEM__CREDENTIALS__ENDPOINT_URL=http://localhost:9000
DESTINATION__FILESYSTEM__CREDENTIALS__REGION_NAME=us-east-1
NORMALIZE__LOADER_FILE_FORMAT=parquet
PYICEBERG_CATALOG__RAW__URI=http://localhost:8181/catalog
PYICEBERG_CATALOG__RAW__WAREHOUSE=raw
ICEBERG_CATALOG__ICEBERG_CATALOG_NAME=raw
ICEBERG_CATALOG__ICEBERG_CATALOG_TYPE=rest
